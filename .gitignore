.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
# Multi-root workspace files reference machine-specific/unrelated folders
*.code-workspace
# Scratch header the polygon editor exports next to itself; the real generated
# data lives in src/TimezonePolyData.h
tools/TimezonePolyData.h

# Loose firmware artifacts (if ever built outside .pio)
*.uf2
*.bin
*.elf
*.hex

# --- KiCad ---
# Per-user project-local state and lock/autosave/backup files
*.kicad_prl
*.lck
~*.lck
*-bak
*.bak
_autosave-*
fp-info-cache

# KiCad timestamped backup archives (large zips)
*-backups/
HARDWARE/production/backups/

# VS Code "Local History" extension (contains its own nested .git)
.history/

# OS cruft
.DS_Store
Thumbs.db

# Claude Code local tooling config
.claude/

# bench-test audio generated by tools/gen_sweep.py (2.6 MB, reproducible)
sweep_*.wav

# screenshot.py default output
/screenshot*.png

# python bytecode from tools/
__pycache__/
